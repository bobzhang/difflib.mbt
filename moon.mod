name = "bobzhang/difflib"

version = "0.1.1"

readme = "README.mbt.md"

repository = "https://github.com/bobzhang/difflib.mbt"

license = "Apache-2.0"

keywords = [ "diff", "difflib", "sequence-matcher", "unified-diff", "ndiff" ]

description = "A faithful MoonBit port of Python's difflib: SequenceMatcher, Differ, ndiff, unified/context diffs, HtmlDiff and get_close_matches."
